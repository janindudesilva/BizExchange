# ==============================================================================
# BizExchange Frontend - Staging Environment Variables Template
# Provide these variables during build time (`npm run build`).
# ==============================================================================

# Public API URL for backend calls (must be the real staging backend domain with /api)
NEXT_PUBLIC_API_URL=https://staging-api.bizexchange.lk/api

# Canonical public frontend domain for staging
NEXT_PUBLIC_SITE_URL=https://staging.bizexchange.lk
