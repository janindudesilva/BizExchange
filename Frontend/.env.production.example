# ==============================================================================
# BizExchange Frontend - Production Environment Variables Template
# Provide these variables during build time (`npm run build`).
# Note: Next.js inlines NEXT_PUBLIC_* variables during the build step.
# ==============================================================================

# Public API URL for backend calls (must be the real production backend domain with /api)
# Example: https://api.bizexchange.lk/api or https://bizexchange.lk/api
NEXT_PUBLIC_API_URL=https://api.bizexchange.lk/api

# Canonical public frontend domain for OpenGraph, metadata, and browser links
NEXT_PUBLIC_SITE_URL=https://bizexchange.lk
