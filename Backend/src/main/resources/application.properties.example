# ==============================================================================
# BizExchange Backend - Example Configuration Template
# Copy this file to application-local.properties for local development.
# In production, pass these via environment variables.
# ==============================================================================

spring.application.name=business-exchange-backend
server.port=8080

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
spring.datasource.url=jdbc:postgresql://localhost:5432/BizExchange
spring.datasource.username=postgres
spring.datasource.password=your_secure_db_password

# HikariCP Connection Pool
spring.datasource.hikari.maximum-pool-size=20
spring.datasource.hikari.minimum-idle=5
spring.datasource.hikari.idle-timeout=300000
spring.datasource.hikari.connection-timeout=20000
spring.datasource.hikari.max-lifetime=1200000
spring.datasource.hikari.leak-detection-threshold=15000

# ------------------------------------------------------------------------------
# Flyway Database Migrations
# ------------------------------------------------------------------------------
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=0
spring.flyway.locations=classpath:db/migration

# ------------------------------------------------------------------------------
# JPA & Hibernate Configuration
# ------------------------------------------------------------------------------
spring.jpa.open-in-view=false
# Use 'validate' in production or after Flyway migrations run
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=false

# ------------------------------------------------------------------------------
# Security & JWT Configuration
# ------------------------------------------------------------------------------
# Secret must be at least 256 bits (32+ characters)
jwt.secret=your-256-bit-secret-key-change-this-in-production-min-32-chars
jwt.expiration=86400000

# ------------------------------------------------------------------------------
# Bootstrap Administrator Account
# ------------------------------------------------------------------------------
app.admin.email=admin@bizexchange.local
app.admin.password=YourStrongAdminPassword123!
app.admin.full-name=System Administrator

# ------------------------------------------------------------------------------
# File Upload Configuration (20MB file limit)
# ------------------------------------------------------------------------------
spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=20MB
spring.servlet.multipart.max-request-size=100MB

# ------------------------------------------------------------------------------
# OTP & Authentication Policy
# ------------------------------------------------------------------------------
app.otp.expiry.minutes=10
app.otp.max-attempts=5
app.password.min-length=8
app.password.max-failed-attempts=5

# ------------------------------------------------------------------------------
# Email Delivery Configuration (SMTP or Resend)
# ------------------------------------------------------------------------------
# Standard SMTP:
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=your-email@example.com
spring.mail.password=your-app-specific-password
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# Resend API (Alternative transactional email provider):
resend.api-key=re_your_resend_api_key_here
resend.from-address=onboarding@resend.dev

# ------------------------------------------------------------------------------
# CORS & Web Origins
# ------------------------------------------------------------------------------
cors.allowed-origins=http://localhost:3000
management.endpoints.web.exposure.include=health,info

# ------------------------------------------------------------------------------
# Test Mailbox (Disabled by default; enable ONLY for local automated E2E tests)
# ------------------------------------------------------------------------------
# Strictly inactive in production. Must be set to true only in isolated local/test
# environments when running verify_e2e_workflow.mjs or verify_browser_flows.mjs.
app.test-mailbox.enabled=false
