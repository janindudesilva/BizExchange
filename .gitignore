# ==========================================
# BizExchange - Root .gitignore
# ==========================================

# ------------------------------------------
# Backend (Spring Boot & Maven)
# ------------------------------------------
target/
**/target/
*.class

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven Wrapper & runtime files
.mvn/timing.properties
hs_err_pid*
replay_pid*

# Spring Boot sensitive configurations & properties (main application)
Backend/src/main/resources/application.properties
Backend/src/main/resources/application-*.properties
Backend/src/main/resources/application.yml
Backend/src/main/resources/application-*.yml
Backend/src/main/resources/application.yaml
Backend/src/main/resources/application-*.yaml
!Backend/src/main/resources/application.properties.example
!Backend/src/main/resources/application.yml.example
!Backend/src/main/resources/application.yaml.example

# ------------------------------------------
# Frontend (Next.js & Node)
# ------------------------------------------
node_modules/
**/node_modules/
.next/
**/.next/
out/
**/out/
build/
**/build/
dist/
**/dist/

# Next.js / TypeScript build output
*.tsbuildinfo
next-env.d.ts
Frontend/next-env.d.ts

# Next.js auto-generated assistant docs
Frontend/AGENTS.md
Frontend/CLAUDE.md
AGENTS.md
CLAUDE.md

# Vercel & Deployments
.vercel/
Frontend/.vercel/

# Environment Variables & Secrets
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
Frontend/.env*
!Frontend/.env.example
!Frontend/.env*.example
!.env.example
!.env*.example

# ------------------------------------------
# Tests & Coverage
# ------------------------------------------
coverage/
**/coverage/
*.lcov
.nyc_output

# ------------------------------------------
# IDEs & Code Editors
# ------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Visual Studio Code
.vscode/
!.vscode/settings.json.example

# Eclipse
.classpath
.project
.settings/
.factorypath

# NetBeans
/nbproject/private/
/build/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Vim / Sublime Text
*.sw?
*.swo
*.swn
*~
*.sublime-project
*.sublime-workspace

# ------------------------------------------
# Operating System Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# ------------------------------------------
# Logs
# ------------------------------------------
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------
# AI Assistants, Skills & Local Tooling
# ------------------------------------------
.agents/
.aider*
.augment/
.autohand/
.bob/
.claude/
.codeartsdoer/
.codebuddy/
.codemaker/
.codestudio/
.cursor/
.continue/
skills/
skills-lock.json
data/
